generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model PixelSettings {
  id                    Int      @id @default(autoincrement())
  shop                  String   @unique
  metaPixelId           String?
  metaAccessTokenCipher String?
  metaTestEventCode     String?
  metaMode              String   @default("TEST")
  trackingEnabled       Boolean  @default(false)
  browserTracking       Boolean  @default(true)
  serverTracking        Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model MetaEventDelivery {
  id             String   @id @default(cuid())
  shop           String
  pixelId        String
  eventName      String
  eventId        String
  eventTime      DateTime
  eventSourceUrl String?

  browserAttempted Boolean @default(false)
  serverAttempted  Boolean @default(false)

  status         String
  httpStatus     Int?
  eventsReceived Int?
  fbTraceId      String?

  errorMessage     String?
  errorType        String?
  errorCode        Int?
  errorSubcode     Int?
  errorIsTransient Boolean?
  errorUserTitle   String?
  errorUserMessage String?

  hasClientIp        Boolean @default(false)
  hasClientUserAgent Boolean @default(false)
  testMode           Boolean @default(false)

  attemptCount Int       @default(1)
  deliveredAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([shop, createdAt])
  @@index([shop, status, createdAt])
  @@index([shop, eventName, createdAt])
  @@index([shop, eventId])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model PixelSettings {
  id                    Int      @id @default(autoincrement())
  shop                  String   @unique
  metaPixelId           String?
  metaAccessTokenCipher String?
  metaTestEventCode     String?
  metaMode              String   @default("TEST")
  trackingEnabled       Boolean  @default(false)
  browserTracking       Boolean  @default(true)
  serverTracking        Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model MetaEventDelivery {
  id             String   @id @default(cuid())
  shop           String
  pixelId        String
  eventName      String
  eventId        String
  eventTime      DateTime
  eventSourceUrl String?

  browserAttempted Boolean @default(false)
  serverAttempted  Boolean @default(false)

  status         String
  httpStatus     Int?
  eventsReceived Int?
  fbTraceId      String?

  errorMessage     String?
  errorType        String?
  errorCode        Int?
  errorSubcode     Int?
  errorIsTransient Boolean?
  errorUserTitle   String?
  errorUserMessage String?

  hasClientIp        Boolean @default(false)
  hasClientUserAgent Boolean @default(false)

  hasFbp           Boolean?
  hasFbc           Boolean?
  hasEmail         Boolean?
  hasPhone         Boolean?
  hasFirstName     Boolean?
  hasLastName      Boolean?
  hasCity          Boolean?
  hasState         Boolean?
  hasPostalCode    Boolean?
  hasCountry       Boolean?
  marketingAllowed Boolean?

  testMode Boolean @default(false)

  attemptCount Int       @default(1)
  deliveredAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([shop, createdAt])
  @@index([shop, status, createdAt])
  @@index([shop, eventName, createdAt])
  @@index([shop, eventId])
}

model MetaDestination {
  id                String   @id @default(cuid())
  shop              String
  name              String
  pixelId           String
  accessTokenCipher String
  testEventCode     String?
  mode              String   @default("PRODUCTION")
  enabled           Boolean  @default(true)
  isPrimary         Boolean  @default(false)
  browserTracking   Boolean  @default(true)
  serverTracking    Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([shop, pixelId])
  @@index([shop, enabled])
  @@index([shop, isPrimary])
}

model MetaMarketingConnection {
  id                String    @id @default(cuid())
  shop              String    @unique
  adAccountId       String
  businessId        String?
  accessTokenCipher String
  enabled           Boolean   @default(true)
  verified          Boolean   @default(false)
  accountName       String?
  lastVerifiedAt    DateTime?
  verificationError String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model MetaAudience {
  id                   String    @id @default(cuid())
  shop                 String
  metaAudienceId       String?
  name                 String
  description          String?
  audienceType         String
  sourceAudienceId     String?
  segmentType          String?
  segmentConfig        Json?
  destinationCountries Json?
  ratio                Float?
  customerCount        Int?
  status               String    @default("DRAFT")
  operationStatus      String?
  errorMessage         String?
  lastSyncedAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  syncLogs MetaAudienceSyncLog[]

  @@unique([shop, metaAudienceId])
  @@index([shop, audienceType])
  @@index([shop, status])
  @@index([shop, createdAt])
}

model MetaAudienceSyncLog {
  id                   String    @id @default(cuid())
  audienceId           String
  shop                 String
  trigger              String
  status               String
  operation            String?
  customerCount        Int?
  emailIdentifierCount Int?
  phoneIdentifierCount Int?
  identifiersSent      Int?
  identifiersReceived  Int?
  metaErrorType        String?
  metaErrorCode        Int?
  metaErrorSubcode     Int?
  metaTraceId          String?
  errorMessage         String?
  startedAt            DateTime  @default(now())
  completedAt          DateTime?
  createdAt            DateTime  @default(now())

  audience MetaAudience @relation(fields: [audienceId], references: [id], onDelete: Cascade)

  @@index([audienceId, startedAt])
  @@index([shop, startedAt])
  @@index([shop, status, startedAt])
  @@index([trigger, startedAt])
}
